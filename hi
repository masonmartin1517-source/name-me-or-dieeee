import pygame

pygame.init()

# Screen size
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("Moving Square")
clock = pygame.time.Clock()
# Create the square
square = pygame.Rect(400, 300, 50, 50)

# Speed of square
speed = 5
gravity = .5
fall_speed = 0
jump_power = -14
standing_on_something = False
jump = -2
running = True



ground = pygame.Rect(0, 550, 900, 50)
floating_platform = pygame.Rect(300, 400, 200, 20)
spike1 = pygame.Rect(300, 500, 60, 50)
platforms = [ground, floating_platform]
spike2 = pygame.Rect(450, 500, 60, 50)
spikes = [spike2, spike1]

font = pygame.font.Font(None, 36)
running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Key press events
    keys = pygame.key.get_pressed()

    
    if keys[pygame.K_LEFT]:
        square.x -= speed
    if keys[pygame.K_RIGHT]:
        square.x += speed
    if keys[pygame.K_SPACE] :
        fall_speed = jump
    if keys[pygame.K_UP] and standing_on_something:
            fall_speed = jump_power
    # Step 1: remember where the bottom of the square was before it moves
    bottom_before = square.bottom

    # Step 2: gravity speeds up the fall, then we actually move the square
    fall_speed += gravity
    square.y += fall_speed
    standing_on_something = False


    for platform in platforms:
        square_was_above_platform = bottom_before <= platform.top
        square_touches_platform_now = square.colliderect(platform)
        if square_was_above_platform and square_touches_platform_now:
            square.bottom = platform.top
            fall_speed = 0 
            standing_on_something = True
    for spike in spikes:            
        square_touches_spike_now = square.colliderect(spike)
        if square_touches_spike_now:
            print("You DIEEEEEEED!!!!! lol")
            square.x = 0
            square.y = 480
    # Clear the screen
    screen.fill((209, 0, 28))


    for platform in platforms:
        pygame.draw.rect(screen, (60, 180, 75), platform)
    
    # Draw the square
    pygame.draw.rect(screen, (46, 255, 227), square)

    for spike in spikes:
                pygame.draw.rect(screen, (0, 0, 0), spike)
    # Update the display
    position_text = font.render(f"Position: ({square.x}, {square.y})", True, (255, 255, 255))
    screen.blit(position_text, (10, 10))
    
    
    pygame.display.flip()

    

    if square.y < -200:
        square.y = 600
    if square.y > 600:
        square.y = -2 
    if square.x < -20:
        square.x = 800
    if square.x > 800:
        square.x = -20

    pygame.display.flip()
    clock.tick(60)




pygame.quit()
